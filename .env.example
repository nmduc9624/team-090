# Choose one or both providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Default model
DEFAULT_MODEL=claude-sonnet-4-20250514
# DEFAULT_MODEL=gpt-4o

# Logging
LOG_LEVEL=INFO

# App backend config
APP_APP_NAME=AI Threat Intel to Hunt Package Assistant
APP_APP_VERSION=0.1.0
APP_AI_PROVIDER=mock
APP_ANALYZER_MODE=hybrid
APP_OPENAI_API_KEY=
APP_OPENAI_CHAT_MODEL=gpt-4.1-mini
APP_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
APP_VECTOR_STORE=local
APP_RAG_TOP_K=4
APP_RAG_CANDIDATE_MULTIPLIER=2
APP_RAG_CONTEXT_CHARS=900
APP_RAG_CACHE_ENABLED=true
APP_DATA_DIR=D:\AI20k\c2-app-090\C2-App-090\data
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
APP_FIRESTORE_ENABLED=false
APP_FIREBASE_PROJECT_ID=soc-hunt-assistant
APP_FIREBASE_REQUIRE_AUTH=false
GOOGLE_APPLICATION_CREDENTIALS=D:\AI20k\firebase-keys\soc-hunt-service-account.json

# Discord bot integration for warning/ticket workflow
DISCORD_BOT_TOKEN=
DISCORD_ESCALATION_CHANNEL_ID=
# Preferred supervisor mention variables. Use raw Discord IDs, not @names.
DISCORD_SUPERVISOR_USER_ID=
DISCORD_SUPERVISOR_ROLE_ID=
# Backward-compatible prototype names. Prefer DISCORD_SUPERVISOR_* above.
DISCORD_ANALYST_USER_ID=
DISCORD_ANALYST_ROLE_ID=

# Frontend Firebase Auth config
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=soc-hunt-assistant
VITE_FIREBASE_APP_ID=

# AI Hook Logging (set by instructor)
AI_LOG_SERVER=
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
