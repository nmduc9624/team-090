// Generic DCSync replication hunt. Review table/field names against your Windows Security schema.
SecurityEvent
| where TimeGenerated > ago(24h)
| where EventID == 4662
| where Properties has_any ("DS-Replication-Get-Changes", "DS-Replication-Get-Changes-All", "1131f6aa", "1131f6ad")
| project TimeGenerated, Computer, SubjectAccount, Account, IpAddress, ObjectName, Properties
