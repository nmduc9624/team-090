// Hunt suspicious LSASS access and credential dumping behavior.
DeviceProcessEvents
| where Timestamp > ago(24h)
| where ProcessCommandLine has_any ("lsass", "procdump", "comsvcs.dll", "nanodump", "sekurlsa")
   or FileName in~ ("procdump.exe", "rundll32.exe")
| project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName
