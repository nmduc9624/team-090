// Find one source attempting authentication against many accounts.
SigninLogs
| where TimeGenerated > ago(24h)
| where ResultType != 0
| summarize failed_users=dcount(UserPrincipalName), attempts=count(), users=make_set(UserPrincipalName) by IPAddress, bin(TimeGenerated, 30m)
| where failed_users >= 10 and attempts >= 20
| project TimeGenerated, IPAddress, failed_users, attempts, users
